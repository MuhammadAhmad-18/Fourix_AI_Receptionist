DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/fourix_clinic?schema=public"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# Clinic bootstrap (used by prisma/seed.ts)
CLINIC_TIMEZONE="Asia/Karachi"

# File storage (Phase 1: local disk provider — see ENVIRONMENT.md to swap for S3/R2)
FILE_STORAGE_PROVIDER="local"
FILE_STORAGE_LOCAL_DIR="./.uploads"

# Deployment target: A (self-hosted Node) or B (serverless) — see ENVIRONMENT.md
DEPLOYMENT_TARGET="A"
